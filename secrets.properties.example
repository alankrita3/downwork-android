# Copy to secrets.properties (gitignored) and fill in. Every key is optional:
# without API_BASE_URL* the app runs on its built-in demo backend; without
# REVENUECAT_API_KEY purchases are unavailable (demo backend grants credits directly).
API_BASE_URL_DEBUG=https://<api-id>.execute-api.ap-south-1.amazonaws.com/v1/
API_BASE_URL=https://<prod-api-id>.execute-api.ap-south-1.amazonaws.com/v1/
REVENUECAT_API_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxx
